# Copy to deploy/.env and fill in the values marked "MUST CALIBRATE" /
# "CONFIRM" before field use. Loaded by all three systemd units
# (EnvironmentFile=-deploy/.env) and by kiosk.sh for DASHBOARD_URL.
#
# For local/simulate-mode dev, none of this is required -- every driver
# falls back to a simulated one automatically when its hardware library
# can't be imported. Set SENSOR_MODE=simulate / LORA_MODE=simulate below
# to force it even when hardware happens to be present (e.g. a demo).

# ============================== shared ====================================
NODE_ID=fisher-01
LOG_LEVEL=INFO

# ============================== sensor-service =============================
SENSOR_MODE=auto
SENSOR_SERVICE_PORT=8100

GAS_POLL_INTERVAL_S=3
LOAD_POLL_INTERVAL_S=3
GPS_POLL_INTERVAL_S=2
CAMERA_SNAPSHOT_INTERVAL_S=5
UPLINK_SAMPLE_INTERVAL_S=45
HISTORY_RETENTION_MINUTES=1440

# --- MQ135 via MCP3008 (SPI) ---
MCP3008_BUS=0
MCP3008_DEVICE=0
MQ135_CHANNEL=0
ADC_VREF=3.3
MQ135_RL_KOHM=10.0
# MUST CALIBRATE: sensor resistance in clean air, per physical unit,
# after a 24-48h burn-in. Leave at 0 to keep ppm/level reporting
# "unknown" rather than a fabricated number. See README.md.
MQ135_R0_KOHM=0.0

# --- HX711 load cell ---
HX711_DT_PIN=5
HX711_SCK_PIN=6
# MUST CALIBRATE with a known reference weight -- see README.md.
HX711_OFFSET=0.0
HX711_SCALE=1.0

# --- GPS (Sologood M10, UART/NMEA) ---
GPS_PORT=/dev/serial0
GPS_BAUD=9600

# --- Camera (IMX135, CSI) ---
CAMERA_WIDTH=1024
CAMERA_HEIGHT=768

# ============================== backend =====================================
BACKEND_PORT=8000
SENSOR_SERVICE_URL=http://localhost:8100
WS_PUSH_INTERVAL_S=1.0
STALE_AFTER_S=8.0

# ============================== lora-uplink =================================
LORA_MODE=auto

# CONFIRM against your actual gateway + local regulations before field
# use. Default targets Indonesia's unlicensed LPWAN allocation
# (~920-923 MHz per Kominfo) -- many hobbyist SX1276/RFM95 boards are
# silkscreened 433/868/915 MHz, but frequency is software-tunable on the
# radio chip itself, not fixed by the board. See README.md.
LORA_FREQ_MHZ=923.0
LORA_TX_POWER_DBM=17
LORA_SPREADING_FACTOR=7
LORA_BANDWIDTH_HZ=125000
LORA_CODING_RATE=5
LORA_CS_PIN=D25
LORA_RESET_PIN=D22

SEND_RETRY_INTERVAL_S=60
DRAIN_THROTTLE_S=3
BUFFER_CAP_ROWS=50000
LORA_WAIT_ACK=false
LORA_ACK_TIMEOUT_S=2.0
# Dev/test only -- forces a fraction of simulated sends to "fail" so you
# can watch the retry/backlog path without real hardware. Leave at 0 normally.
SIMULATE_FAIL_RATE=0.0

# ============================== kiosk.sh ====================================
DASHBOARD_URL=http://localhost:8000
